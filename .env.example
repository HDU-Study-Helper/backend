# Local development only. Copy to .env and replace the password.
POSTGRES_USER=academic
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=academic
POSTGRES_PORT=5432
DATABASE_URL=postgres://academic:change-me-local-only@127.0.0.1:5432/academic?sslmode=disable
HTTP_ADDR=:2610
# Optional fixed browser origin (required behind a reverse proxy).
PUBLIC_ORIGIN=http://127.0.0.1:2610
COOKIE_SECURE=false
# Set both on the first startup only; use a strong password of 12-72 bytes.
# BOOTSTRAP_ADMIN_USERNAME=admin
# BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-password

# DWS is disabled until all three settings are provided.
# Generate a key: openssl rand -base64 32. Keep it stable and outside the database backup.
# CREDENTIAL_KEY=
# DWS_BINARY=/absolute/path/to/official/dws
# DWS_BINARY_SHA256=<sha256sum-of-pinned-official-binary>
DWS_WORKSPACE_ROOT=/dev/shm
# Shared information-refresh clock (learning platforms + DWS, excluding jwxt).
REFRESH_INTERVAL=10m
# Legacy DWS_POLL_INTERVAL is still accepted if REFRESH_INTERVAL is unset.
DWS_COMMAND_TIMEOUT=45s

# Agent 控制台默认使用真实模型配置；本地自测可设 true，不调用外部模型。
AGENT_DEMO_ENABLED=false
